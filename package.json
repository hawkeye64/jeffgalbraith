{
  "name": "jeffgalbraith-dev",
  "version": "0.0.1",
  "private": true,
  "description": "Jeff Galbraith's personal website",
  "author": "Jeff <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxlint --ignore-path .oxlintignore .",
    "lint:fix": "oxlint --ignore-path .oxlintignore --fix .",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "typecheck": "vue-tsc --project tsconfig.vue-tsc.json --noEmit",
    "test": "echo \"No test specified\" && exit 0",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:build": "pnpm build",
    "check:all": "pnpm verify",
    "verify": "pnpm verify:fast && pnpm verify:build",
    "deep": "ncu --configFilePath . --packageFile package.json",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "2.0.3",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "marked-gfm-heading-id": "^4.1.4",
    "quasar": "2.25.0",
    "snapsvg": "^0.5.1",
    "snapsvg-cjs-ts": "^0.0.6",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "3.6.0",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "npm-check-updates": "^23.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.22.0",
  "productName": "Jeff Galbraith"
}
